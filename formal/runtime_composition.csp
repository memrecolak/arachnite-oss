-- runtime_composition.csp
-- CSP_M encoding of the interrupt policies COMPOSED with the runtime
-- (v0.13 semantics, ADR 0005): the ActionMasterNode interrupt gate,
-- mid-step observation points (steps refined into begin/end pairs), the
-- graceful-stop and emergency-stop paths, non-blocking action tasks, one
-- actuator resource shared by the deliberative action and a reflex action,
-- and reflex arbitration (PREEMPT / WAIT_FOR_BLOCK, rollback_on_preempt).
-- Companion to interrupt_policies.csp (the four policy processes in
-- isolation).  Model derived from the v0.13 source:
--   MultiStepActionNode.execute / check_interrupt / on_interrupted /
--     _run_safe_stop / _handle_reflex_preempt
--   ActionMasterNode.request_interrupt (MandatoryBlockViolation gate),
--     interrupt_all, launch, launch_reflex, _preempt, _admit_armed
--   ArachniteRuntime.emergency_stop, ArachniteRuntime.tick
--
-- The assertions mirror the exhaustive state-space checks of
-- verify_runtime_composition.py, which is the licence-free proof
-- instrument for this model (it also sweeps every step layout with N <= 6
-- and is validated by mutation_check_composition.py).  This file is the
-- canonical encoding for readers with a working FDR4.
--
-- Five-step harmonised instance: steps 1..3 mandatory with rollback,
-- steps 4..5 interruptible, step 5 the only checkpoint.

N = 5
STEPS = {1..N}

channel begin, end_, roll, proll, bail : STEPS
channel reqA, reqR, reqD, sreq, estop      -- gate outcomes, stop(), emergency
channel dispatch, ack, stop, cancel, safe_stop, halt
channel sense, reflex_fire, no_reflex, instinct_eval, decide_done, act_done, t_loop
channel rlaunch_f, rlaunch_c, rlaunch_dedup, r_begin, r_end

Interruptible(i) = i >= 4
Checkpoint(i)    = i == 5
HasRollback(i)   = i <= 3
StopPoint(i)     = Interruptible(i) or i == 1 or Interruptible(i - 1)

datatype PolicyT = ALWAYSP | NEVERP | CHECKPOINTP | ROLLBACKP
datatype ModeT   = PREEMPTM | WAITM

Honours(p, i) =
  StopPoint(i) and
  (p == ALWAYSP or p == ROLLBACKP or (p == CHECKPOINTP and Checkpoint(i)))

Bails(p, i) =
  Interruptible(i) and
  (p == ALWAYSP or p == ROLLBACKP or (p == CHECKPOINTP and Checkpoint(i)))

reverse_(<>) = <>
reverse_(<x> ^ xs) = reverse_(xs) ^ <x>
rollq(done) = <j | j <- reverse_(done), (not Interruptible(j)) and HasRollback(j)>
preq(rb, done) = if rb then rollq(done) else <>

-- ── The deliberative action (node + gate + stop paths + preemption) ────
-- rlaunch_c is a conflicting reflex launch: its effect on the owner is
-- launch_reflex's (cancel now, or wait for the block under WAIT_FOR_BLOCK);
-- rlaunch_f / r_begin are only possible while the owner holds nothing.

IDLE(p, m, rb) =
     estop -> ESTOP
  [] reqD -> IDLE(p, m, rb)
  [] dispatch -> EXEC(p, m, rb, <1..N>, <>, false, false)
  [] rlaunch_f -> IDLE(p, m, rb)
  [] rlaunch_dedup -> IDLE(p, m, rb)
  [] r_begin -> IDLE(p, m, rb)

ESTOP = safe_stop -> halt -> SKIP          -- emergency: safe-stop, no rollback

-- boundary before head(is) (or the end of the sequence)
EXEC(p, m, rb, is, done, pnd, rp) =
  if null(is) then
       estop -> ESTOP
    [] reqD -> EXEC(p, m, rb, is, done, pnd, rp)
    [] rlaunch_dedup -> EXEC(p, m, rb, is, done, pnd, rp)
    [] rlaunch_c -> PRE(p, m, rb, preq(rb, done))
    [] stop -> IDLE(p, m, rb)
  else
    let cur = head(is) within
       ENV(p, m, rb, is, done, pnd, rp, false)
    [] (if rp and StopPoint(cur) then
          cancel -> PRE(p, m, rb, preq(rb, done))
        else if pnd and Honours(p, cur) then
          (if p == ROLLBACKP then UNDO(p, m, rb, rollq(done)) else ack -> ACKED(p, m, rb))
        else
          begin.cur -> INSTEP(p, m, rb, is, done, pnd, rp))

-- inside step head(is)
INSTEP(p, m, rb, is, done, pnd, rp) =
  let cur = head(is) within
     ENV(p, m, rb, is, done, pnd, rp, true)
  [] end_.cur -> EXEC(p, m, rb, tail(is), done ^ <cur>, pnd, rp)
  [] (pnd and Bails(p, cur)) &
       bail.cur -> (if p == ROLLBACKP then UNDO(p, m, rb, rollq(done))
                    else BAILED(p, m, rb))

-- environment events offered while the action runs a step or sits at a
-- boundary: the gate, the graceful-stop request, emergency stop, and the
-- effect of a reflex launch
ENV(p, m, rb, is, done, pnd, rp, ins) =
  let cur = head(is)
      BACK(np, nrp) = if ins then INSTEP(p, m, rb, is, done, np, nrp)
                      else EXEC(p, m, rb, is, done, np, nrp)
  within
     (if Interruptible(cur) then reqA -> BACK(true, rp) else reqR -> BACK(pnd, rp))
  [] sreq -> BACK(true, rp)
  [] estop -> ESTOP
  [] rlaunch_dedup -> BACK(pnd, rp)
  [] rlaunch_c ->
       (if m == WAITM and not Interruptible(cur) then BACK(pnd, true)
        else PRE(p, m, rb, preq(rb, done)))

-- deliberative rollback walk (cancelled by a preemption: safe-stop only)
UNDO(p, m, rb, q) =
     estop -> ESTOP
  [] rlaunch_dedup -> UNDO(p, m, rb, q)
  [] rlaunch_c -> PRE(p, m, rb, <>)
  [] (if null(q) then ack -> ACKED(p, m, rb)
      else roll.head(q) -> UNDO(p, m, rb, tail(q)))

BAILED(p, m, rb) =
     estop -> ESTOP [] rlaunch_dedup -> BAILED(p, m, rb)
  [] rlaunch_c -> BAILED(p, m, rb) [] ack -> ACKED(p, m, rb)

ACKED(p, m, rb) =
     estop -> ESTOP [] rlaunch_dedup -> ACKED(p, m, rb)
  [] rlaunch_c -> ACKED(p, m, rb) [] stop -> IDLE(p, m, rb)

-- preempted: safe-stop, rollback walk only with rollback_on_preempt, release
PRE(p, m, rb, q) =
     estop -> ESTOP [] rlaunch_dedup -> PRE(p, m, rb, q)
  [] safe_stop -> PREROLL(p, m, rb, q)
PREROLL(p, m, rb, q) =
     estop -> ESTOP [] rlaunch_dedup -> PREROLL(p, m, rb, q)
  [] (if null(q) then stop -> IDLE(p, m, rb)
      else proll.head(q) -> PREROLL(p, m, rb, tail(q)))

OWNER(p, m, rb) = IDLE(p, m, rb)

-- ── Reflex action (its own task) and the tick loop ─────────────────────
-- An armed reflex claims the resource: no deliberative dispatch until it
-- has run.
R_IDLE  = rlaunch_f -> R_ARMED [] rlaunch_c -> R_ARMED [] dispatch -> R_IDLE
R_ARMED = rlaunch_dedup -> R_ARMED [] r_begin -> R_RUN
R_RUN   = rlaunch_dedup -> R_RUN [] r_end -> R_IDLE

TICK = sense ->
       ((reflex_fire -> (rlaunch_f -> INSTINCT [] rlaunch_c -> INSTINCT
                         [] rlaunch_dedup -> INSTINCT))
        [] (no_reflex -> INSTINCT))
INSTINCT = instinct_eval -> DECIDE
DECIDE = decide_done -> ACT [] reqA -> ACT [] reqR -> ACT [] reqD -> ACT
ACT = act_done -> t_loop -> TICK

LAUNCH = {| rlaunch_f, rlaunch_c, rlaunch_dedup |}
GATE   = {| reqA, reqR, reqD |}

-- The runtime keeps running in the composition (emergency stop is checked
-- on the action alone): estop is in the synchronisation set but offered by
-- neither TICK nor the reflex, so it is blocked here.
SYSTEM(p, m, rb) =
  (TICK [| LAUNCH |] (R_IDLE))
    [| union(union(GATE, LAUNCH), {| dispatch, r_begin, estop |}) |]
  OWNER(p, m, rb)

-- ── Specifications ─────────────────────────────────────────────────────
RUNALL = ([] x : Events @ x -> RUNALL) [] SKIP

-- 4. mandatory-step atomicity: no ack/roll/bail inside a mandatory step
ATOMIC = ([] i : STEPS @ begin.i ->
            (if Interruptible(i) then ATOMIC else INMAND(i)))
         [] ([] x : diff(Events, {| begin, ack, roll, bail |}) @ x -> ATOMIC)
         [] SKIP
INMAND(i) = end_.i -> ATOMIC [] estop -> ATOMIC
            [] ([] x : diff(Events, {| end_, estop, ack, roll, bail |}) @ x -> INMAND(i))

-- 6. no spurious interrupt: ack/roll/bail only after reqA or sreq
COLD = ([] x : diff(Events, {| ack, roll, bail, reqA, sreq |}) @ x -> COLD)
       [] reqA -> ARMED [] sreq -> ARMED [] SKIP
ARMED = ([] x : diff(Events, {| dispatch |}) @ x -> ARMED)
        [] dispatch -> COLD [] SKIP

-- 7. rollback order (ROLLBACK): roll.3, roll.2, roll.1 in that order
ROLLORD = ([] x : diff(Events, {| roll |}) @ x -> ROLLORD)
          [] (roll.3 -> R2 [] roll.2 -> R1' [] roll.1 -> RA) [] SKIP
R2  = ([] x : diff(Events, {| roll |}) @ x -> R2)  [] roll.2 -> R1' [] SKIP
R1' = ([] x : diff(Events, {| roll |}) @ x -> R1') [] roll.1 -> RA  [] SKIP
RA  = ([] x : diff(Events, {| roll |}) @ x -> RA)  [] SKIP

-- 8b. NEVER admits no ack at all
NOACK = ([] x : diff(Events, {| ack |}) @ x -> NOACK) [] SKIP

-- 9. emergency stop: only the safe-stop, then halt (no step, rollback, ack)
ESPEC = ([] x : diff(Events, {| estop |}) @ x -> ESPEC)
        [] estop -> safe_stop -> halt -> SKIP [] SKIP

-- 10. block atomicity: once step 1 began, no ack until step 3 ended
BLOCKATOMIC = ([] x : diff(Events, {| begin.1 |}) @ x -> BLOCKATOMIC)
              [] begin.1 -> INB [] SKIP
INB = end_.3 -> BLOCKATOMIC [] dispatch -> BLOCKATOMIC
      [] ([] x : diff(Events, {| ack, end_.3, dispatch |}) @ x -> INB) [] SKIP

-- 12. a fired reflex is launched before the decide stage completes
RBD = ([] x : diff(Events, union(union(LAUNCH, GATE),
                                 {| reflex_fire, decide_done |})) @ x -> RBD)
      [] reflex_fire -> RBDF
      [] ([] x : union(LAUNCH, union(GATE, {| decide_done |})) @ x -> RBD)
      [] SKIP
RBDF = ([] x : diff(Events, union(union(LAUNCH, GATE), {| decide_done |})) @ x -> RBDF)
       [] ([] x : LAUNCH @ x -> RBD)

-- 14/18. exclusivity and claims: no deliberative dispatch from a reflex
-- launch until the reflex action has ended
EXCL = ([] x : diff(Events, {| rlaunch_f, rlaunch_c |}) @ x -> EXCL)
       [] rlaunch_f -> CLAIM [] rlaunch_c -> CLAIM [] SKIP
CLAIM = ([] x : diff(Events, {| dispatch, r_end |}) @ x -> CLAIM)
        [] r_end -> EXCL [] SKIP

-- 15. preemption ordering: after a conflicting launch the reflex begins
-- only after the owner released (stop)
ORDER = ([] x : diff(Events, {| rlaunch_c |}) @ x -> ORDER)
        [] rlaunch_c -> WAITREL [] SKIP
WAITREL = ([] x : diff(Events, {| r_begin, stop |}) @ x -> WAITREL)
          [] stop -> ORDER [] SKIP

-- 16. PREEMPT: no step begins or ends between the launch and the release
PROMPT = ([] x : diff(Events, {| rlaunch_c |}) @ x -> PROMPT)
         [] rlaunch_c -> PR1 [] SKIP
PR1 = ([] x : diff(Events, {| begin, end_, stop |}) @ x -> PR1)
      [] stop -> PROMPT [] SKIP

-- 17. WAIT_FOR_BLOCK: until the release, only the block in progress may
-- continue -- no begin at a stop point, no end of an interruptible step
WAITB = ([] x : diff(Events, {| rlaunch_c |}) @ x -> WAITB)
        [] rlaunch_c -> WB1 [] SKIP
WB1 = ([] x : diff(Events, {| begin, end_, stop |}) @ x -> WB1)
      [] ([] i : STEPS @ (not StopPoint(i)) & begin.i -> WB1)
      [] ([] i : STEPS @ (not Interruptible(i)) & end_.i -> WB1)
      [] stop -> WAITB [] SKIP

-- 18. without rollback_on_preempt there is no preemption rollback
NOPROLL = ([] x : diff(Events, {| proll |}) @ x -> NOPROLL) [] SKIP

-- ── Assertions ─────────────────────────────────────────────────────────
assert OWNER(ALWAYSP, PREEMPTM, false)     :[deadlock free]
assert OWNER(ROLLBACKP, WAITM, true)       :[deadlock free]
assert SYSTEM(ALWAYSP, PREEMPTM, false)    :[deadlock free]
assert SYSTEM(ROLLBACKP, PREEMPTM, true)   :[deadlock free]
assert SYSTEM(ALWAYSP, WAITM, false)       :[deadlock free]
assert SYSTEM(ROLLBACKP, WAITM, true)      :[deadlock free]

assert ATOMIC      [T= OWNER(ALWAYSP, PREEMPTM, false)
assert ATOMIC      [T= OWNER(CHECKPOINTP, PREEMPTM, false)
assert ATOMIC      [T= OWNER(ROLLBACKP, PREEMPTM, false)
assert COLD        [T= OWNER(ALWAYSP, PREEMPTM, false)
assert COLD        [T= OWNER(ROLLBACKP, PREEMPTM, false)
assert ROLLORD     [T= OWNER(ROLLBACKP, PREEMPTM, false)
assert NOACK       [T= OWNER(NEVERP, PREEMPTM, false)
assert ESPEC       [T= OWNER(ALWAYSP, PREEMPTM, false)
assert ESPEC       [T= OWNER(ROLLBACKP, PREEMPTM, true)
assert BLOCKATOMIC [T= OWNER(ALWAYSP, PREEMPTM, false)
assert BLOCKATOMIC [T= OWNER(ROLLBACKP, PREEMPTM, false)

assert RBD     [T= SYSTEM(ALWAYSP, PREEMPTM, false)
assert RBD     [T= SYSTEM(ROLLBACKP, WAITM, true)
assert EXCL    [T= SYSTEM(ALWAYSP, PREEMPTM, false)
assert EXCL    [T= SYSTEM(ROLLBACKP, WAITM, true)
assert ORDER   [T= SYSTEM(ALWAYSP, PREEMPTM, false)
assert ORDER   [T= SYSTEM(ROLLBACKP, WAITM, true)
assert PROMPT  [T= SYSTEM(ALWAYSP, PREEMPTM, false)
assert PROMPT  [T= SYSTEM(ROLLBACKP, PREEMPTM, true)
assert WAITB   [T= SYSTEM(ALWAYSP, WAITM, false)
assert WAITB   [T= SYSTEM(ROLLBACKP, WAITM, true)
assert NOPROLL [T= SYSTEM(ALWAYSP, PREEMPTM, false)
assert NOPROLL [T= SYSTEM(ROLLBACKP, WAITM, false)

-- Checks 2 (estop never refused), 3 (gate soundness), 5 (deliberative
-- stops only at stop points), 8a (honour at the first eligible stop point),
-- 13 (reflex launched while the action is inside a mandatory step) and the
-- no-double-undo half of 18 are state-space invariants rather than trace
-- refinements; verify_runtime_composition.py checks them directly over the
-- reachable state space, for every policy, mode and rollback setting.
